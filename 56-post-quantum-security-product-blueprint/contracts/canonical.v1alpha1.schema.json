{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pqc-product/canonical.v1alpha1.schema.json",
  "title": "Synthetic cryptographic observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "tenant_id", "asset_id", "source_type", "source_id", "observed_at", "scope", "parser_version", "sha256", "confidence", "knowledge", "algorithm", "function", "synthetic"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "enum": ["northstar", "aster", "harbor"]},
    "asset_id": {"type": "string", "minLength": 1},
    "source_type": {"type": "string", "enum": ["cbom", "cyclonedx", "tls_csv", "sarif", "kms_json", "vendor_csv", "vendor_json", "manual"]},
    "source_id": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "scope": {"type": "string", "minLength": 1},
    "parser_version": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "knowledge": {"type": "string", "enum": ["verified", "inferred", "declared_by_vendor", "conflicting", "unknown", "stale"]},
    "algorithm": {"type": "string", "minLength": 1},
    "function": {"type": "string", "minLength": 1},
    "note": {"type": "string"},
    "synthetic": {"const": true}
  }
}
