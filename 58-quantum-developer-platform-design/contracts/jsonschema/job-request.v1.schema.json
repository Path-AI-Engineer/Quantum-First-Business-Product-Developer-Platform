{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reference.local/schemas/job-request.v1.schema.json",
  "title": "Quantum platform job request",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "provider", "payload"],
  "properties": {
    "operation": {
      "enum": ["circuit.sample", "observable.estimate", "optimization.solve", "resource.estimate", "workflow.run"]
    },
    "provider": {"enum": ["fake", "local", "ibm", "braket", "azure"]},
    "payload": {"type": "object", "maxProperties": 32}
  }
}

