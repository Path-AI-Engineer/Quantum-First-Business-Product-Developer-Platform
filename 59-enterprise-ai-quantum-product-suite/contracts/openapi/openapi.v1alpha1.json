          },
          "tenant_id": {
            "title": "Tenant Id",
            "type": "string"
          }
        },
        "required": [
          "tenant_id",
          "requester_id",
          "resource_id",
          "scope"
        ],
        "title": "ApprovalRequest",
        "type": "object"
      },
      "AssistantRequest": {
        "properties": {
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "title": "Evidence Ids",
            "type": "array"
          },
          "question": {
            "title": "Question",
            "type": "string"
          },
          "tenant_id": {
            "title": "Tenant Id",
            "type": "string"
          }
        },
        "required": [
          "tenant_id",
          "question",
          "evidence_ids"
        ],
        "title": "AssistantRequest",
        "type": "object"
      },
      "BenchmarkRequest": {
        "properties": {
          "baseline": {
            "default": "deterministic",
            "title": "Baseline",
            "type": "string"
          },
          "opportunity_id": {
            "title": "Opportunity Id",
            "type": "string"
          },
          "tenant_id": {
            "title": "Tenant Id",
            "type": "string"
          }
        },
        "required": [
          "tenant_id",
          "opportunity_id"
        ],
        "title": "BenchmarkRequest",
        "type": "object"
      },
      "DecisionOutcome": {
        "enum": [
          "invest",
          "hold",
          "kill"
        ],
        "title": "DecisionOutcome",
        "type": "string"
      },
      "DecisionRequest": {
        "properties": {
          "assumptions": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Assumptions",
            "type": "array"
          },
          "outcome": {
            "$ref": "#/components/schemas/DecisionOutcome"
          },
          "owner_id": {
            "title": "Owner Id",
            "type": "string"
          },
          "tenant_id": {
            "title": "Tenant Id",
            "type": "string"
          }
        },
        "required": [
          "tenant_id",
          "owner_id",
          "outcome"
        ],
        "title": "DecisionRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "JobRequest": {
        "properties": {
          "approval_id": {
            "title": "Approval Id",
            "type": "string"
          },
          "capability_id": {
            "title": "Capability Id",
            "type": "string"
          },
          "idempotency_key": {
            "title": "Idempotency Key",
            "type": "string"
          },
          "input_reference": {
            "title": "Input Reference",
            "type": "string"
          },
          "tenant_id": {
            "title": "Tenant Id",
            "type": "string"
          }
        },
        "required": [
          "tenant_id",
          "capability_id",
          "approval_id",
          "idempotency_key",
          "input_reference"
        ],
        "title": "JobRequest",
        "type": "object"
      },
      "ReportRequest": {
        "properties": {
          "report_type": {
            "enum": [
              "portfolio",
              "assurance",
              "usage"
            ],
            "title": "Report Type",
            "type": "string"
          },
          "tenant_id": {
            "title": "Tenant Id",
            "type": "string"
          }
        },
        "required": [
          "tenant_id",
          "report_type"
        ],
        "title": "ReportRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
