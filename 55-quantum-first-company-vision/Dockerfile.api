FROM python:3.13-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 VENTURE_ROOT=/app
COPY pyproject.toml README.md ./
COPY src ./src
COPY data ./data
COPY reports ./reports
RUN python -m pip install --no-cache-dir .
EXPOSE 8955
CMD ["python", "-m", "uvicorn", "venture_evidence.api:app", "--host", "0.0.0.0", "--port", "8955"]
